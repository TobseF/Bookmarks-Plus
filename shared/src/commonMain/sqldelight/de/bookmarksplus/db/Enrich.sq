pendingIds:
SELECT id FROM bookmark WHERE deleted_at IS NULL AND scraped_at IS NULL ORDER BY add_date DESC, id DESC;

countPending:
SELECT count(*) FROM bookmark WHERE deleted_at IS NULL AND scraped_at IS NULL;

forEnrich:
SELECT id, uuid, url, favicon_hash, repo_url, website_url, description, thumbnail_path, card_image_path,
       shots_json, avatar_hash, website_icon_hash, thumb_custom_path
FROM bookmark WHERE id = ?;

setFetchResult:
UPDATE bookmark SET link_status = ?, status_checked_at = ?, final_url = ?,
       link_error = CASE WHEN link_error = 'parked' THEN 'parked' END WHERE id = ?;

setMeta:
UPDATE bookmark SET meta_title = ?, meta_description = ?, card_image_url = coalesce(?, card_image_url),
       content_type = coalesce(content_type, ?) WHERE id = ?;

setCardImage:
UPDATE bookmark SET card_image_path = ?, card_image_url = coalesce(?, card_image_url) WHERE id = ?;

setThumbnail:
UPDATE bookmark SET thumbnail_path = ? WHERE id = ?;

setFaviconIfMissing:
UPDATE bookmark SET favicon_hash = ? WHERE id = ? AND favicon_hash IS NULL;

setRepoUrlIfMissing:
UPDATE bookmark SET repo_url = ? WHERE id = ? AND repo_url IS NULL;

setWebsiteUrlIfMissing:
UPDATE bookmark SET website_url = ? WHERE id = ? AND website_url IS NULL;

setGithub:
UPDATE bookmark SET gh_stars = ?, gh_last_commit = ?, gh_last_release = ?, gh_last_release_date = ?,
       gh_author = ?, gh_org = ?, readme = coalesce(?, readme), enriched_at = ?,
       meta_description = coalesce(meta_description, ?)
WHERE id = ?;

-- SourceForge project: author, review count (as stars), last update, current file, description
setSourceforge:
UPDATE bookmark SET gh_stars = :reviews, gh_last_commit = :lastUpdate, gh_last_release = :release,
       gh_last_release_date = :releaseDate, gh_author = :author, gh_org = NULL, enriched_at = :now,
       meta_title = coalesce(:name, meta_title), meta_description = coalesce(:summary, meta_description),
       download_url = :downloadUrl, download_label = :downloadLabel,
       website_url = coalesce(website_url, :homepage), content_type = coalesce(content_type, 'tool')
WHERE id = :id;

-- Regenerate GitHub card from stored README
forReadmeCard:
SELECT id, uuid, url, readme, gh_stars, meta_description, card_image_path FROM bookmark WHERE id = ?;

githubWithReadmeIds:
SELECT id FROM bookmark WHERE deleted_at IS NULL AND readme IS NOT NULL
  AND (url LIKE 'https://github.com/%' OR url LIKE 'http://github.com/%' OR url LIKE 'https://www.github.com/%')
ORDER BY add_date DESC, id DESC;

tagNamesOf:
SELECT t.name FROM bookmark_tag bt JOIN tag t ON t.id = bt.tag_id WHERE bt.bookmark_id = ? ORDER BY t.name;

-- GitHub projects (repo bookmarks or project pages with repo) without README
missingReadmeIds:
SELECT id FROM bookmark WHERE deleted_at IS NULL AND readme IS NULL
  AND (lower(coalesce(repo_url, '')) LIKE 'https://github.com/%' OR lower(url) LIKE 'https://github.com/%'
       OR lower(url) LIKE 'http://github.com/%' OR lower(url) LIKE 'https://www.github.com/%')
ORDER BY add_date DESC, id DESC;

countMissingReadme:
SELECT count(*) FROM bookmark WHERE deleted_at IS NULL AND readme IS NULL
  AND (lower(coalesce(repo_url, '')) LIKE 'https://github.com/%' OR lower(url) LIKE 'https://github.com/%'
       OR lower(url) LIKE 'http://github.com/%' OR lower(url) LIKE 'https://www.github.com/%');

forReadme:
SELECT id, url, repo_url FROM bookmark WHERE id = ?;

setReadme:
UPDATE bookmark SET readme = ? WHERE id = ? AND readme IS NULL;

markEnriched:
UPDATE bookmark SET enriched_at = ? WHERE id = ?;

setShots:
UPDATE bookmark SET shots_json = ? WHERE id = ?;

shotsOf:
SELECT shots_json FROM bookmark WHERE id = ?;

setThumbChoice:
UPDATE bookmark SET thumb_choice = ? WHERE id = ?;

setCustomThumb:
UPDATE bookmark SET thumb_custom_path = ?, thumb_choice = ? WHERE id = ?;

setFavicon:
UPDATE bookmark SET favicon_hash = ? WHERE id = ?;

-- Already scraped SourceForge projects without project data (e.g. created before the SourceForge parser)
pendingSourceforgeIds:
SELECT id FROM bookmark WHERE deleted_at IS NULL AND enriched_at IS NULL AND scraped_at IS NOT NULL
  AND (url LIKE '%sourceforge.net/projects/%' OR url LIKE '%sourceforge.net/p/%')
ORDER BY add_date DESC, id DESC;

markScraped:
UPDATE bookmark SET scraped_at = ? WHERE id = ?;

-- Already scraped repos whose GitHub data is still missing (e.g. due to API limit)
pendingGithubIds:
SELECT id FROM bookmark WHERE deleted_at IS NULL AND repo_url IS NOT NULL AND enriched_at IS NULL AND scraped_at IS NOT NULL
ORDER BY add_date DESC, id DESC;

-- Icon sources (schema v10) -----------------------------------------------------------

setAvatar:
UPDATE bookmark SET avatar_hash = ? WHERE id = ?;

setWebsiteIcon:
UPDATE bookmark SET website_icon_hash = ? WHERE id = ?;

setFlathubIcon:
UPDATE bookmark SET flathub_icon_hash = ? WHERE id = ?;

setAlternativetoIcon:
UPDATE bookmark SET alternativeto_icon_hash = ? WHERE id = ?;

forIcons:
SELECT id, url, repo_url, website_url, avatar_hash, website_icon_hash FROM bookmark WHERE id = ?;

-- GitHub projects without avatar or project websites without favicon
missingIconIds:
SELECT id FROM bookmark WHERE deleted_at IS NULL AND (
    (avatar_hash IS NULL AND (lower(coalesce(repo_url, '')) LIKE 'https://github.com/%' OR lower(url) LIKE 'https://github.com/%'
        OR lower(url) LIKE 'http://github.com/%' OR lower(url) LIKE 'https://www.github.com/%'))
    OR (website_icon_hash IS NULL AND website_url IS NOT NULL
        AND (lower(coalesce(repo_url, '')) LIKE 'https://github.com/%' OR lower(url) LIKE 'https://github.com/%'
        OR lower(url) LIKE 'http://github.com/%' OR lower(url) LIKE 'https://www.github.com/%'))
) ORDER BY add_date DESC, id DESC;

-- GitHub repo set by the user (overrides, NULL removes it)
setRepoUrl:
UPDATE bookmark SET repo_url = ? WHERE id = ?;
